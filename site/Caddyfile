# Serves the built manual on the port Railway gives ($PORT).
{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	@assets path /_astro/* /pagefind/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
